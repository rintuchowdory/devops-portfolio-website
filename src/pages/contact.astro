---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, href } from "../lib/site";

const channels = [
  { label: "GitHub", value: site.githubLabel, href: site.github, note: "Repositories, commits and issues." },
  { label: "Microservice API", value: "devops-portfolio-microservice.vercel.app", href: "https://devops-portfolio-microservice.vercel.app/docs", note: "Swagger UI, no account needed." },
];
---

<BaseLayout
  title="Contact | Rintu Chowdory"
  description="Where to find Rintu Chowdory online, and the fastest way to check the work in this portfolio."
>
  <header class="max-w-2xl">
    <h1 class="text-3xl font-bold text-white sm:text-4xl">Contact</h1>
    <p class="mt-2 text-slate-400">
      No contact form and no mailbox on this site. GitHub is the reliable route, and it keeps
      the whole conversation with the code.
    </p>
  </header>

  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    {channels.map((channel) => (
      <a
        class="glass-panel card-lift flex flex-col p-5"
        href={channel.href}
        target="_blank"
        rel="noreferrer"
      >
        <span class="text-xs uppercase tracking-wider text-slate-500">{channel.label}</span>
        <span class="mono mt-1 break-all text-sm text-indigo-300">{channel.value}</span>
        <span class="mt-2 text-xs text-slate-400">{channel.note}</span>
      </a>
    ))}
  </div>

  <section class="glass-panel mt-4 p-5 sm:p-6">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-300">Before you write</h2>
    <p class="mt-3 text-sm leading-relaxed text-slate-400">
      If you want to check the work first, the fastest path is
      <a class="link" href={href("/dashboard")}>the dashboard</a> for the API in use, or
      <a class="link" href={site.repoMicroservice} target="_blank" rel="noreferrer">the microservice repository</a>
      for the pipeline, the tests and the Dockerfile.
    </p>
  </section>
</BaseLayout>
