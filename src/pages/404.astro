---
import BaseLayout from "../layouts/BaseLayout.astro";
import { href, nav } from "../lib/site";
---

<BaseLayout title="Page not found | Rintu Chowdory" description="That page does not exist. Links to the rest of the portfolio.">
  <div class="glass-panel mx-auto max-w-xl p-8 text-center">
    <p class="mono text-xs uppercase tracking-[0.3em] text-indigo-300">404</p>
    <h1 class="mt-3 text-3xl font-bold text-white">This route returned nothing</h1>
    <p class="mt-3 text-sm text-slate-400">
      The page you asked for is not here. Unlike the API, this site has no health endpoint to
      blame, so try one of these instead.
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-2">
      {nav.slice(0, 4).map((item) => (
        <a class="btn btn-sm btn-outline border-white/25 text-white hover:bg-white/10" href={href(item.path)}>
          {item.label}
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
