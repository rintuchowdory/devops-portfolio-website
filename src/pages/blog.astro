---
import BaseLayout from "../layouts/BaseLayout.astro";
import { posts, href } from "../lib/site";
---

<BaseLayout
  title="Notes | Rintu Chowdory"
  description="Working notes on CI/CD, Docker, testing and Kubernetes from building the DevOps portfolio."
>
  <header class="max-w-2xl">
    <h1 class="text-3xl font-bold text-white sm:text-4xl">Notes</h1>
    <p class="mt-2 text-slate-400">
      Short write-ups of decisions and bugs from these projects. Drafts are listed with the
      summary I already have, and link to the repository in the meantime.
    </p>
  </header>

  <div class="mt-8 grid gap-4 md:grid-cols-2">
    {posts.map((post) => (
      <article class="glass-panel card-lift flex flex-col p-5">
        <div class="flex items-center justify-between gap-3">
          <time class="mono text-xs text-slate-500" datetime={post.date}>{post.date}</time>
          <span class="badge badge-sm border-amber-400/40 bg-amber-400/10 text-[10px] uppercase tracking-wider text-amber-300">
            {post.state}
          </span>
        </div>
        <h2 class="mt-3 text-lg font-semibold text-white">{post.title}</h2>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-400">{post.summary}</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {post.tags.map((tag) => (
            <span class="badge badge-sm badge-outline border-white/20 text-slate-300">{tag}</span>
          ))}
        </div>
      </article>
    ))}
  </div>

  <div class="glass-panel mt-4 flex flex-col gap-3 p-5 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-slate-400">
      Full articles land here as they are finished. The commit history is the unfiltered version.
    </p>
    <a class="btn btn-sm btn-outline border-white/25 text-white hover:bg-white/10" href="https://github.com/rintuchowdory/devops-portfolio-microservice/commits/main" target="_blank" rel="noreferrer">
      Commit history
    </a>
  </div>
</BaseLayout>
