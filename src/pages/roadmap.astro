---
import BaseLayout from "../layouts/BaseLayout.astro";
import { roadmap, href } from "../lib/site";

const groups = [
  { key: "done", title: "Done and verifiable", tone: "text-emerald-300", ring: "border-emerald-400/40 bg-emerald-400/10" },
  { key: "next", title: "Next", tone: "text-sky-300", ring: "border-sky-400/40 bg-sky-400/10" },
  { key: "later", title: "Later", tone: "text-slate-300", ring: "border-white/20 bg-white/5" },
] as const;
---

<BaseLayout
  title="Roadmap | Rintu Chowdory"
  description="What is finished in the DevOps portfolio, what is next, and what is still a plan."
>
  <header class="max-w-2xl">
    <h1 class="text-3xl font-bold text-white sm:text-4xl">Roadmap</h1>
    <p class="mt-2 text-slate-400">
      Ordered by what makes the next project easier to prove. Items marked done link to
      something you can check.
    </p>
  </header>

  <div class="mt-8 space-y-4">
    {groups.map((group) => (
      <section class="glass-panel p-5 sm:p-6">
        <h2 class:list={["text-sm font-semibold uppercase tracking-wider", group.tone]}>{group.title}</h2>
        <ul class="mt-4 space-y-3">
          {roadmap.filter((item) => item.state === group.key).map((item) => (
            <li class="flex items-start gap-3 text-sm text-slate-300">
              <span class:list={["mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full border text-[10px] font-bold", group.ring]}>
                {group.key === "done" ? "✓" : group.key === "next" ? "→" : "·"}
              </span>
              <span>{item.label}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <section class="glass-panel mt-4 p-5 sm:p-6">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-300">Why this order</h2>
    <p class="mt-3 text-sm leading-relaxed text-slate-400">
      A pipeline is only useful if it can fail. The first four items exist so that everything
      after them has a place to deploy to and a way to prove it works: Kubernetes needs an
      image, GitOps needs manifests, and Terraform needs a cluster shape that is already known
      to run. Without that, the later items would be YAML without a feedback loop.
    </p>
    <a href={href("/projects")} class="mt-4 inline-block text-sm text-indigo-300 hover:underline">See what is already running</a>
  </section>
</BaseLayout>
