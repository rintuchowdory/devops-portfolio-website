---
import { nav, site, href } from "../lib/site";

const current = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (path: string) => {
  const target = href(path).replace(/\/+$/, "") || "/";
  return current === target;
};
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-[#070b14]/85 backdrop-blur">
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href={href("/")} class="flex items-center gap-2 font-semibold tracking-tight">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-indigo-500 to-sky-400 text-sm font-black text-[#05080f]">RC</span>
      <span class="hidden sm:inline">{site.name}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {nav.map((item) => (
        <a
          href={href(item.path)}
          aria-current={isActive(item.path) ? "page" : undefined}
          class:list={[
            "rounded-lg px-3 py-2 text-sm transition-colors",
            isActive(item.path)
              ? "bg-white/10 text-white"
              : "text-slate-300 hover:bg-white/5 hover:text-white",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={site.github}
        target="_blank"
        rel="noreferrer"
        class="btn btn-ghost btn-sm text-slate-200"
        aria-label="GitHub profile"
      >
        GitHub
      </a>
      <div class="dropdown dropdown-end md:hidden">
        <button class="btn btn-ghost btn-sm" tabindex="0" aria-label="Open menu">Menu</button>
        <ul class="menu dropdown-content z-50 mt-1 w-52 rounded-box border border-white/10 bg-[#0b1220] p-2 shadow-xl">
          {nav.map((item) => (
            <li>
              <a href={href(item.path)} class={isActive(item.path) ? "active" : ""}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</header>
